# Asistensia Learn (Supabase) — copy to .env.local and add the same vars in Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API Keys. Use the *publishable* key (sb_publishable_…), never the secret/service_role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
